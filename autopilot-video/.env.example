# Copy to .env and fill in. Never commit .env.

# Claude API
ANTHROPIC_API_KEY=

# Cost control (must match .claude/rules/cost-rules.md)
DAILY_COST_LIMIT_USD=5.00

# Pexels stock footage
PEXELS_API_KEY=

# Telegram approval gate + alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APPROVAL_TIMEOUT_MINUTES=60

# YouTube Data API (OAuth refresh-token flow)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Meta Graph API (Facebook Reels + Instagram Reels)
META_ACCESS_TOKEN=
FB_PAGE_ID=
IG_ACCOUNT_ID=
# Instagram requires the final video at a public URL (Graph API fetches it):
PUBLIC_VIDEO_BASE_URL=

# Server port (Railway injects PORT automatically; default 8000 locally)
PORT=8000
